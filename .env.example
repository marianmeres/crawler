# FOR POSTGRES (USED IN TESTS ONLY)
TEST_PG_HOST=localhost
TEST_PG_DATABASE=crawler_test
TEST_PG_USER=
TEST_PG_PASSWORD=
TEST_PG_PORT=5432

# FOR THE INTERACTIVE EXAMPLE APP (`deno task example`)
# A database of its own — the example installs the crawler's five tables plus steve's
# queue tables under the `example_` prefix, and never touches the test database.
EXAMPLE_PG_HOST=localhost
EXAMPLE_PG_DATABASE=example_crawler
EXAMPLE_PG_USER=
EXAMPLE_PG_PASSWORD=
EXAMPLE_PG_PORT=5432

# Optional, example only:
#   PORT                    the port to listen on (default 8000)
#   EXAMPLE_HOST            bind address (default 127.0.0.1; a deployment sets 0.0.0.0)
#   EXAMPLE_ALLOW_IMPOLITE  1 lets the UI turn robots.txt off. Local use only.
